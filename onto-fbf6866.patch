@@ -0,0 +1,96 @@
+# .env.example — copy to .env before `make up`:
+#
+#     cp .env.example .env
+#
+# .env is gitignored. Do not commit it, and do not put a real secret in THIS
+# file — it is tracked, and everything below is a placeholder chosen to be
+# obviously fake.
+#
+# ---------------------------------------------------------------------------
+# WHICH OF THESE ACTUALLY REACH THE CONTAINERS
+# ---------------------------------------------------------------------------
+# Only the six variables in the first section are interpolated by
+# docker-compose.yml (the `${VAR:-default}` entries under `environment:`).
+# Everything else the app reads — DATABASE_URL, REDIS_URL, CLICKHOUSE_*,
+# KAFKA_BOOTSTRAP, MODEL_DIR — is set directly in the compose file, pointing at
+# service names on the compose network.
+#
+# This matters because settings.py's _load_dotenv uses os.environ.setdefault:
+# a variable already present in the real environment wins over .env. Inside a
+# container compose has already set it, so adding e.g. EXPLORATION_EPSILON here
+# will silently do nothing. To tune those, add them to the `environment:` block
+# in docker-compose.yml. The second section below is for running the app or the
+# training job on your host, outside compose, where .env is the only source.
+
+# ---------------------------------------------------------------------------
+# 1. Read by docker-compose.yml
+# ---------------------------------------------------------------------------
+
+# Password for the `adplatform` Postgres role. Compose builds DATABASE_URL from
+# it. Changing this after the first `make up` will NOT change the password in
+# the existing volume — the database was initialised with the old one. Either
+# keep it, or `docker compose down -v` and start clean.
+POSTGRES_PASSWORD=adplatform
+
+# Absolute base URL the gateway stamps into {{CLICK_URL}} in every creative.
+# Wrong value here means every click 404s in the browser while the server logs
+# look perfectly healthy.
+PUBLIC_BASE_URL=http://localhost:8000
+
+# HMAC pepper for API key hashing (auth.hash_api_key). Deterministic by design,
+# so the hash of a key changes if this changes — rotating it invalidates every
+# issued key at once. That is the intended emergency lever, not a routine one.
+#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
+API_KEY_PEPPER=dev-only-insecure-pepper
+
+# Bearer token for the /admin endpoints. Compared with hmac.compare_digest.
+# Empty disables admin routes; anything you would not paste in a public issue
+# is fine for local work.
+#   generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
+ADMIN_TOKEN=change-me-to-a-random-string
+
+# Single env-var API key so a fresh install can call /v1/bid before any
+# publisher row exists. auth._bootstrap_keys refuses to activate it when
+# ENV=production. Prefer `make seed`, which issues a real key against a real
+# publisher row; leave this empty unless you are debugging auth itself.
+BOOTSTRAP_API_KEY=
+BOOTSTRAP_PUBLISHER_ID=pub_demo
+
+# ---------------------------------------------------------------------------
+# 2. Only used when running OUTSIDE compose
+# ---------------------------------------------------------------------------
+# Uncomment these to run the gateway, scripts.seed_inventory or ml.train_ctr
+# directly on your host against the containerised backing services. The
+# hostnames become localhost because you are no longer on the compose network,
+# and the ports are the ones docker-compose.yml publishes.
+#
+# DATABASE_URL=postgresql://adplatform:adplatform@localhost:5432/adplatform
+# REDIS_URL=redis://localhost:6379
+# CLICKHOUSE_HOST=localhost
+# CLICKHOUSE_PORT=8123
+# CLICKHOUSE_USER=default
+# CLICKHOUSE_PASSWORD=
+# CLICKHOUSE_DATABASE=default
+# KAFKA_BOOTSTRAP=localhost:19092
+# MODEL_DIR=./models/current
+
+# ---------------------------------------------------------------------------
+# 3. Tuning — defaults live in settings.py
+# ---------------------------------------------------------------------------
+# Listed so you know they exist. Setting them here only has an effect outside
+# compose; see the note at the top.
+#
+# ENV=development                  # `production` disables BOOTSTRAP_API_KEY
+# LOG_LEVEL=INFO
+# INVENTORY_REFRESH_SECONDS=60     # how long a paused ad keeps serving
+# MODEL_REFRESH_SECONDS=60         # how fast a promoted model goes live
+# API_KEY_REFRESH_SECONDS=60       # how long a revoked key keeps working
+# STATS_REFRESH_SECONDS=300
+# STATS_LOOKBACK_DAYS=30
+# EXPLORATION_EPSILON=0.08         # share of auctions given to a random ad
+# BUDGET_RECONCILE_SECONDS=300
+# BUDGET_KEY_TTL_SECONDS=172800
+# BID_RATE_LIMIT=100/second
+# STATS_RATE_LIMIT=10/minute
+# PG_MIN_SIZE=2
+# PG_MAX_SIZE=10
